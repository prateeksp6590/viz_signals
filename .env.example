# ── InfluxDB (the same instance viz_hedge writes ticks into) ──────────────────
INFLUX_URL=https://us-east-1-1.aws.cloud2.influxdata.com
INFLUX_TOKEN=
INFLUX_ORG=VizHedge
# single shared bucket, dateless measurements
INFLUX_BUCKET=tick_data
# triggers/orders/positions land here
SIGNALS_BUCKET=signals

# ── What to analyse ──────────────────────────────────────────────────────────
# Same instrument-key format the feeder uses. Copy from viz_hedge/.env.
ANALYZE_INSTRUMENTS=
# BSE.json / MCX.json read from same dir
NSE_JSON_PATH=../viz_hedge/data/NSE.json

# ── Engine loop ──────────────────────────────────────────────────────────────
POLL_INTERVAL_SECS=5
# must comfortably exceed ANGLE_N2 ticks
LOOKBACK_MINUTES=60
ENGINE_START=09:16
ENGINE_STOP=15:30

# ── Strategy: slope_angle ────────────────────────────────────────────────────
# Geometry: at tick n read ltp at n, n-N1, n-N2; two rays share an origin at n-N2
# and the signal is the angle between them (a curvature detector, not a trend one).
# middle sample, n-N1
ANGLE_N1=50
# oldest sample, n-N2
ANGLE_N2=80
# pct = %/tick (portable across instruments)
ANGLE_PRICE_MODE=pct
                                 # abs = Rs/tick (threshold is per-instrument)

# Threshold. A FIXED angle cannot survive a volatility regime change, so by default
# fire on the top (1-q) of this instrument's OWN recent angles. Calibrated
# 2026-07-29 on BSE SENSEX 77500 CE: q=0.95 held in both halves of the day
# (PF 1.82 / 2.01) where q>=0.99 flipped sign between them.
# NOTE: max angle observed was 20 deg (pct) / 48 deg (abs) -- a 60 deg threshold
# never fires. Always recalibrate: python backtest/backtest.py --sweep
# percentile | mad | fixed
ANGLE_THRESH_MODE=percentile
# ticks in the adaptive window (~25 min)
ANGLE_WINDOW=2000
# percentile mode
ANGLE_Q=0.95
# mad mode
ANGLE_MAD_K=5
# only used when ANGLE_THRESH_MODE=fixed
ANGLE_THRESHOLD_DEG=60

# Long-only: buy CE on an upward bend. Capture downside by pointing this same
# strategy at the PE, not by shorting.
ANGLE_LONG_ONLY=true
# also demand slope_full > slope_base (accelerating)
ANGLE_REQUIRE_CONVEX=true
ANGLE_EXIT_ON_REVERSE=true

# ── Execution ────────────────────────────────────────────────────────────────
# signals_only | paper | live
ORDER_MODE=signals_only
ORDER_QTY_DEFAULT=1
SLIPPAGE_BPS=5

# ── Risk gate ────────────────────────────────────────────────────────────────
SIGNAL_COOLDOWN_SECS=300
MAX_OPEN_POSITIONS=5
MAX_ORDER_NOTIONAL=500000
DAILY_LOSS_LIMIT=10000

PERSIST_TO_INFLUX=true
LOG_LEVEL=INFO

FOLLOW_FEEDER=always
FEEDER_ENV=/home/ubuntu/viz_hedge/.env
