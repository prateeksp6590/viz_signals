# PROFILE C — B, plus equities long AND short with 5x intraday margin.
# Equity charges are ~11% of a 0.5% move versus ~61% for options, which may matter
# more than any parameter tuned so far.
# WARNING: this changes TWO things at once versus B. If results differ, you cannot
# tell whether the ITM filter or the equities did it. Run B first for a session.
ANALYZE_SEGMENTS=NSE_FO,BSE_FO,NSE_EQ
ANALYZE_MONEYNESS=ATM,OTM
SHORT_SEGMENTS=NSE_EQ,BSE_EQ
EXIT_STOP_SIGMA=4.0
EXIT_TRAIL_SIGMA=2.0
EXIT_TARGET_PCT=0
EXIT_MAX_HOLD_SECS=3600
ANGLE_Q=0.95
MAX_OPEN_POSITIONS=20
EQUITY_MARGIN_PER_TRADE=20000
EQUITY_LEVERAGE=5
