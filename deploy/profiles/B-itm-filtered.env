# PROFILE B — one change at a time: drop ITM legs, widen the stop. Options only.
# Hypothesis: ITM legs were the whole of 08-04's loss (SENSEX ITM puts lost 6,308 /
# 3,848 / 3,238 while OTM calls made +4,256 / +3,090), and every trade stopped inside
# 30s was a loser across two independent sessions.
# Expected: fewer trades (~half the chain is ITM), fewer sub-30s exits.
ANALYZE_SEGMENTS=NSE_FO,BSE_FO
ANALYZE_MONEYNESS=ATM,OTM
SHORT_SEGMENTS=
EXIT_STOP_SIGMA=4.0
EXIT_TRAIL_SIGMA=2.0
EXIT_TARGET_PCT=0
EXIT_MAX_HOLD_SECS=3600
ANGLE_Q=0.95
MAX_OPEN_POSITIONS=20
