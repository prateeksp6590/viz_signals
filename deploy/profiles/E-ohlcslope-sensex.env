# PROFILE E — week of 2026-08-10. OHLC-mean slope, SENSEX OPTIONS ONLY.
#
# PURPOSE: gather a full week of live data under a configuration the research has
# NOT already scored to death, on the one instrument family that showed anything.
# It is a DATA COLLECTION run, not a bet.
#
# READ THIS BEFORE DRAWING CONCLUSIONS FROM THE P&L
# -------------------------------------------------
# The closest relative of this detector (slope-angle on the 1-min mean of OPEN and
# CLOSE, n1/n2=5/8, q=0.50) was scored in strategy_research.ipynb:
#
#     4-day pilot   256 trades  46% win  median -412   positive on 2/4 days
#     30 series     ...         45% win  NET -439,035  positive on 5/30
#
# The OHLC mean is a 4-point average instead of 2-point, so expect similar
# behaviour. A negative week is the BASE CASE and confirms the research; a positive
# week on 5 sessions proves nothing on its own -- renko+slope was positive on 4 days
# and lost 280,342 across 30 series.
#
# ORDER_MODE MUST STAY paper. Do not switch this to live.
#
# WHY SENSEX ONLY. Split by index on the 30-series pull, the rebound detector was
# +294,841 on BSE_SENSEX and -63,234 on NSE_NIFTY. Whatever is there (if anything)
# is a SENSEX effect, and mixing NIFTY in only adds noise. Equities were -42,806 on
# 389 trades over two sessions and are excluded outright.

ORDER_MODE=paper
STRATEGY_NAME=ohlc_mean_slope

# SENSEX options are BSE_FO. NIFTY options (NSE_FO) and equities (NSE_EQ) are out.
ANALYZE_SEGMENTS=BSE_FO
ANALYZE_MONEYNESS=ATM,OTM

# SENSEX futures share the BSE_FO segment, and the instrument KEY does not say
# which is which -- only the trading symbol does. The feeder still COLLECTS them
# (CHAIN_FUTURES=1 in prep_day.sh); they are excluded from signalling here.
ANALYZE_EXCLUDE_SYMBOLS=FUT

# Long only. The short book on every detector measured worse or was outlier-driven,
# and shorting a long option is not the same trade as shorting the underlying.
ANGLE_LONG_ONLY=true
SHORT_SEGMENTS=

# Bars, not ticks. The tick strategy's 50/80 would need 80 minutes of history per
# signal at 1-min bars. 5/8 matches what the research scored.
OHLC_SLOPE_INTERVAL=1min
OHLC_SLOPE_N1=5
OHLC_SLOPE_N2=8
OHLC_SLOPE_WINDOW=120
OHLC_SLOPE_MIN_SAMPLES=30
# q=0.80 rather than 0.50: at 1-min bars a session is only 375 bars, and q=0.50
# fires on roughly half of them. Measured on synthetic bars, q=0.80 gives ~19%.
OHLC_SLOPE_Q=0.80

# Risk gates carried over from profile D — these are the part of the research that
# actually held up. Four oversized positions caused most of one day's loss.
MAX_NOTIONAL_PER_TRADE=50000
MIN_PREMIUM=20
MAX_OPEN_POSITIONS=20

EXIT_STOP_SIGMA=4.0
EXIT_TRAIL_SIGMA=2.0
EXIT_TARGET_PCT=0
# 20 minutes. Across every dataset examined, trades held under 10 minutes lost
# (381 trades, -20,037 gross) and those held longer made money (96 trades, +17,760).
EXIT_MAX_HOLD_SECS=1200

# WHAT TO CHECK ON FRIDAY, and in this order:
#   1. Did the daily loss limit fire, and when? Three sessions running it truncated
#      the day to ~75 minutes, which makes the P&L a sample of the morning only.
#   2. utils/signal_pnl.py --date <each day>, then compare against
#      utils/replay_journal.py. They share one charge model now; if they disagree,
#      that is a NEW bug.
#   3. top1/top5 share of net, and the median trade. A positive NET with a ~zero
#      median is five lucky trades, and that has fooled this project twice.
#   4. Signals per session. If it fires >100 times a day the threshold is too low
#      and charges will dominate regardless of direction.
#
# ROLLBACK:  bash deploy/apply_profile.sh D-risk-capped
